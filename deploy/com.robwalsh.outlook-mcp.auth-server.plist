<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.robwalsh.outlook-mcp.auth-server</string>

    <!-- Absolute node path (from `which node`) + the auth server script -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/Rob/claude/github/outlook-mcp/outlook-auth-server.js</string>
    </array>

    <!-- Required: the auth server calls dotenv.config() with no path, so it loads
         .env relative to the working directory. Must be the repo root. -->
    <key>WorkingDirectory</key>
    <string>/Users/Rob/claude/github/outlook-mcp</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/Rob</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Start at login and keep it alive across crashes (and reboots, via login) -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/Rob/Library/Logs/outlook-mcp/auth-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Rob/Library/Logs/outlook-mcp/auth-server.error.log</string>
</dict>
</plist>
