<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.robwalsh.outlook-mcp.logcap</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/Rob/claude/github/outlook-mcp/deploy/cap-logs.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/Rob</string>
    </dict>

    <!-- Run weekly: Sunday 03:10. Does not run at load. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/Rob/Library/Logs/outlook-mcp/logcap.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Rob/Library/Logs/outlook-mcp/logcap.log</string>
</dict>
</plist>
